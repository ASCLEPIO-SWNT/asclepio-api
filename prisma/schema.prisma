// Esquema de Asclepio. Las tablas viven en el esquema PostgreSQL "asclepio" (ADR 0003).
// Cada feature añade sus modelos mediante migraciones nuevas (ver docs/data-model.md).
// Prisma 7: las URLs no van aquí. CLI y migraciones → prisma.config.ts (DIRECT_URL);
// runtime → PrismaClient con @prisma/adapter-pg (DATABASE_URL, pooler 6543).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // F-02 (D7): índices únicos parciales declarados en el schema (Prisma >= 7.4, preview) para que no haya drift.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["asclepio"]
}

// ---------------------------------------------------------------- F-01: auth, roles y tenancy

enum UserRole {
  RECEPTION
  NURSE
  PHYSICIAN
  ADMIN

  @@map("user_role")
  @@schema("asclepio")
}

enum ActorType {
  STAFF
  PATIENT
  SYSTEM

  @@map("actor_type")
  @@schema("asclepio")
}

/// Valores de sexo admitidos (PA-5, confirmados por el humano el 2026-10-26).
enum PatientSex {
  M
  F
  X

  @@map("patient_sex")
  @@schema("asclepio")
}

/// IPS (tenant). Dueño: tenancy.
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sites             Site[]
  users             User[]
  patients          Patient[]
  patientAccounts   PatientAccount[]
  auditLogs         AuditLog[]
  encounters        Encounter[]
  preRegistrations  PreRegistration[]
  encounterEvents   EncounterEvent[]
  vitalSigns        VitalSign[]
  symptomFindings   SymptomFinding[]
  triageSuggestions TriageSuggestion[]
  triageDecisions   TriageDecision[]

  @@map("tenants")
  @@schema("asclepio")
}

/// Sede de una IPS. Dueño: tenancy.
model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encounters       Encounter[]
  preRegistrations PreRegistration[]

  @@unique([tenantId, name])
  @@unique([id, tenantId]) // F-02 (D11): destino de las FKs compuestas con el tenant
  @@map("sites")
  @@schema("asclepio")
}

/// Personal. Dueño: users. Email único global y guardado en minúsculas (D7).
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  role           UserRole
  active         Boolean   @default(true)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registeredEncounters       Encounter[]        @relation("EncounterRegisteredBy")
  resolvedPreRegistrations   PreRegistration[]
  recordedVitalSigns         VitalSign[]
  recordedSymptomFindings    SymptomFinding[]
  requestedTriageSuggestions TriageSuggestion[]
  triagedEncounters          Encounter[]        @relation("EncounterTriagedBy")
  triageDecisions            TriageDecision[]

  @@index([tenantId])
  @@map("users")
  @@schema("asclepio")
}

/// Paciente. Dueño: patients. Columnas nullables porque F-02 registra pacientes NN o graves sin todos los datos.
/// CHECK manuales (migración f02_patients_encounters): documento completo o ausente; edad estimada solo en NN y 0–120.
model Patient {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  documentType       String?     @map("document_type")
  documentNumber     String?     @map("document_number")
  fullName           String?     @map("full_name")
  birthDate          DateTime?   @map("birth_date") @db.Date
  sex                PatientSex?
  /// Edad estimada en años (solo NN sin fecha de nacimiento, PA-F02-1).
  estimatedAgeYears  Int?        @map("estimated_age_years") @db.SmallInt
  /// Hora del servidor en que recepción verificó la identidad (D8). No NULL → el perfil ya no es editable (R3).
  identityVerifiedAt DateTime?   @map("identity_verified_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accounts         PatientAccount[] // como mucho una: patient_accounts.patient_id es único
  encounters       Encounter[]
  preRegistrations PreRegistration[]

  @@unique([tenantId, documentType, documentNumber])
  @@unique([id, tenantId])
  @@map("patients")
  @@schema("asclepio")
}

/// Cuenta de paciente (principal separado de users, ADR 0008). Dueño: auth.
/// FK compuesta (patient_id, tenant_id) → patients(id, tenant_id): la cuenta no puede cruzar tenants.
model PatientAccount {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  patientId        String    @unique @map("patient_id") @db.Uuid
  passwordHash     String    @map("password_hash")
  consentAt        DateTime  @map("consent_at") @db.Timestamptz(6)
  consentVersion   String    @map("consent_version")
  identityVerified Boolean   @default(false) @map("identity_verified")
  active           Boolean   @default(true)
  failedAttempts   Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@map("patient_accounts")
  @@schema("asclepio")
}

/// Auditoría append-only (RNF-02). Dueño: audit. asclepio_app solo tiene SELECT e INSERT (migración f01_app_role_grants).
/// actor_id sin FK (D12): el actor puede ser un users, una patient_accounts, el sistema o nadie (fallos de login).
model AuditLog {
  id         BigInt     @id @default(autoincrement())
  tenantId   String?    @map("tenant_id") @db.Uuid
  actorType  ActorType? @map("actor_type")
  actorId    String?    @map("actor_id") @db.Uuid
  action     String
  entity     String
  entityId   String?    @map("entity_id")
  metadata   Json       @default("{}")
  occurredAt DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(6)

  // Restrict (no SET NULL/CASCADE): las acciones referenciales se ejecutan como dueño de la tabla y saltarían los grants append-only.
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, occurredAt])
  @@map("audit_log")
  @@schema("asclepio")
}

// ---------------------------------------------------------------- F-02: pre-registro y atenciones

enum ComplaintSource {
  TYPED
  VOICE_ON_DEVICE

  @@map("complaint_source")
  @@schema("asclepio")
}

enum EncounterStatus {
  REGISTERED
  WAITING_TRIAGE
  TRIAGED
  IN_CARE
  CLOSED
  CANCELLED

  @@map("encounter_status")
  @@schema("asclepio")
}

enum EncounterOrigin {
  PRE_REGISTRATION
  DIRECT

  @@map("encounter_origin")
  @@schema("asclepio")
}

enum PreRegistrationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  REJECTED

  @@map("pre_registration_status")
  @@schema("asclepio")
}

/// Atención. Dueño: encounters. Solo se actualiza junto con su encounter_event y su auditoría (misma transacción).
/// FKs compuestas con el tenant (D11). Como mucho una atención activa por paciente (D7, índice único parcial).
/// final_level, triaged_at y triaged_by (F-05-api, D8): solo los fija la decisión de triage (R9) y van juntos.
/// CHECK manuales (migración f05_triage_decisions): los tres nulos o los tres no nulos, y no nulos en TRIAGED, IN_CARE y CLOSED.
model Encounter {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  siteId             String          @map("site_id") @db.Uuid
  patientId          String          @map("patient_id") @db.Uuid
  status             EncounterStatus
  origin             EncounterOrigin
  /// Hora legal de llegada (Res. 373, ADR 0008): la pone la API con el Clock; sin default.
  arrivalAt          DateTime        @map("arrival_at") @db.Timestamptz(6)
  chiefComplaintText String          @map("chief_complaint_text")
  complaintSource    ComplaintSource @map("complaint_source")
  registeredBy       String          @map("registered_by") @db.Uuid
  cancellationReason String?         @map("cancellation_reason")
  /// Nivel final de triage (1–5) decidido por enfermería (F-05-api, R9). Hora y responsable del servidor y del token.
  finalLevel         Int?            @map("final_level") @db.SmallInt
  triagedAt          DateTime?       @map("triaged_at") @db.Timestamptz(6)
  triagedBy          String?         @map("triaged_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // F-02 corrección 1: todas RESTRICT. ON UPDATE CASCADE (valor por defecto de Prisma) reescribiría la atención sin evento
  // ni auditoría al cambiar el id referenciado (las acciones referenciales se ejecutan como dueño y saltan los grants).
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site              Site               @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  patient           Patient            @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  registeredByUser  User               @relation("EncounterRegisteredBy", fields: [registeredBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  triagedByUser     User?              @relation("EncounterTriagedBy", fields: [triagedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  preRegistrations  PreRegistration[] // como mucho uno: pre_registrations.encounter_id es único
  events            EncounterEvent[]
  vitalSigns        VitalSign[]
  symptomFindings   SymptomFinding[]
  triageSuggestions TriageSuggestion[]
  triageDecisions   TriageDecision[] // como mucho una: triage_decisions.encounter_id es único (PA-F05-1)

  @@unique([id, tenantId])
  @@unique([patientId], map: "encounters_one_active_per_patient", where: raw("status <> ALL (ARRAY['CLOSED'::asclepio.encounter_status, 'CANCELLED'::asclepio.encounter_status])"))
  @@index([tenantId, arrivalAt(sort: Desc)])
  @@index([tenantId, status, arrivalAt])
  @@index([tenantId, patientId])
  @@map("encounters")
  @@schema("asclepio")
}

/// Pre-registro enviado por el paciente desde la app (ADR 0008). Dueño: encounters (D1).
/// Expiración perezosa (D2): el estado efectivo es EXPIRED si status = PENDING y expires_at <= hora del servidor.
model PreRegistration {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  patientId          String                @map("patient_id") @db.Uuid
  siteId             String                @map("site_id") @db.Uuid
  chiefComplaintText String                @map("chief_complaint_text")
  complaintSource    ComplaintSource       @map("complaint_source")
  status             PreRegistrationStatus @default(PENDING)
  preRegisteredAt    DateTime              @map("pre_registered_at") @db.Timestamptz(6)
  expiresAt          DateTime              @map("expires_at") @db.Timestamptz(6)
  resolvedAt         DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolvedBy         String?               @map("resolved_by") @db.Uuid
  encounterId        String?               @unique @map("encounter_id") @db.Uuid
  rejectionReason    String?               @map("rejection_reason")
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // F-02 corrección 1: todas RESTRICT (ver Encounter).
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient        Patient    @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  site           Site       @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  resolvedByUser User?      @relation(fields: [resolvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // MATCH SIMPLE: no se comprueba mientras encounter_id es NULL. Restrict: nunca SET NULL sobre tenant_id (NOT NULL).
  encounter      Encounter? @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([patientId], map: "pre_registrations_one_pending_per_patient", where: raw("status = 'PENDING'"))
  @@index([tenantId, status, expiresAt])
  @@index([patientId, preRegisteredAt(sort: Desc)])
  @@map("pre_registrations")
  @@schema("asclepio")
}

/// Línea de tiempo append-only de la atención (RNF-02). Dueño: encounters. asclepio_app solo tiene SELECT e INSERT.
/// actor_id sin FK (D10); payload sin datos personales (R41). Todas sus FKs son RESTRICT (D12).
model EncounterEvent {
  id          BigInt           @id @default(autoincrement())
  tenantId    String           @map("tenant_id") @db.Uuid
  encounterId String           @map("encounter_id") @db.Uuid
  /// ENCOUNTER_CREATED | STATUS_CHANGED (texto, D15: cada feature añade tipos sin ALTER TYPE).
  type        String
  fromStatus  EncounterStatus? @map("from_status")
  toStatus    EncounterStatus? @map("to_status")
  payload     Json             @default("{}")
  actorType   ActorType        @map("actor_type")
  actorId     String?          @map("actor_id") @db.Uuid
  occurredAt  DateTime         @map("occurred_at") @db.Timestamptz(6)

  // Restrict (no SET NULL/CASCADE): las acciones referenciales se ejecutan como dueño de la tabla y saltarían los grants append-only.
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encounter Encounter @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@index([encounterId, occurredAt, id])
  @@index([tenantId, occurredAt])
  @@map("encounter_events")
  @@schema("asclepio")
}

// ---------------------------------------------------------------- F-03: captura clínica

/// Nivel de conciencia ACVPU (PA-F03-1, NEWS2 RCP 2017). PROVISIONAL — no validado clínicamente, revisar con asesor clínico.
enum ConsciousnessLevel {
  A
  C
  V
  P
  U

  @@map("consciousness_level")
  @@schema("asclepio")
}

/// Tipo de hallazgo (PA-F03-3): SYMPTOM = lo que refiere el paciente, FINDING = lo que observa enfermería,
/// COMPLAINT_NOTE = precisión del motivo de consulta (PA-F03-4).
enum SymptomFindingKind {
  SYMPTOM
  FINDING
  COMPLAINT_NOTE

  @@map("symptom_finding_kind")
  @@schema("asclepio")
}

/// Toma de signos vitales: una fila por toma, solo inserciones (asclepio_app: SELECT e INSERT). Dueño: encounters (D1).
/// Las columnas de signos son NULL en la base (D2): la obligatoriedad y los rangos viven en VITAL_SIGN_DEFINITIONS.
/// CHECK manual (migración f03_clinical_capture): al menos un signo.
model VitalSign {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  encounterId        String              @map("encounter_id") @db.Uuid
  respiratoryRate    Int?                @map("respiratory_rate") @db.SmallInt
  oxygenSaturation   Int?                @map("oxygen_saturation") @db.SmallInt
  supplementalOxygen Boolean?            @map("supplemental_oxygen")
  systolicBp         Int?                @map("systolic_bp") @db.SmallInt
  heartRate          Int?                @map("heart_rate") @db.SmallInt
  consciousness      ConsciousnessLevel?
  temperatureC       Decimal?            @map("temperature_c") @db.Decimal(4, 1)
  diastolicBp        Int?                @map("diastolic_bp") @db.SmallInt
  glucoseMgDl        Int?                @map("glucose_mg_dl") @db.SmallInt
  /// Hora del servidor (Clock, D10); sin default.
  recordedAt         DateTime            @map("recorded_at") @db.Timestamptz(6)
  recordedBy         String              @map("recorded_by") @db.Uuid

  // D13: todas RESTRICT (las acciones referenciales se ejecutan como dueño y saltarían los grants append-only).
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encounter      Encounter @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  recordedByUser User      @relation(fields: [recordedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([encounterId, recordedAt, id])
  @@index([tenantId, recordedAt])
  @@map("vital_signs")
  @@schema("asclepio")
}

/// Síntoma, hallazgo o nota del motivo: una fila por elemento, solo inserciones (asclepio_app: SELECT e INSERT).
/// Texto libre estructurado (PA-F03-3), sin catálogo ni code. CHECK manual: description de 1 a 500 sin espacios extremos.
model SymptomFinding {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  encounterId String             @map("encounter_id") @db.Uuid
  kind        SymptomFindingKind
  description String
  /// Hora del servidor (Clock, D10); sin default.
  recordedAt  DateTime           @map("recorded_at") @db.Timestamptz(6)
  recordedBy  String             @map("recorded_by") @db.Uuid

  // D13: todas RESTRICT.
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encounter      Encounter @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  recordedByUser User      @relation(fields: [recordedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([encounterId, recordedAt, id])
  @@index([tenantId, recordedAt])
  @@map("symptom_findings")
  @@schema("asclepio")
}

// ---------------------------------------------------------------- F-04: sugerencia de triage por LLM

/// Resultado de una solicitud de sugerencia (F-04-api): OK, salida del LLM inválida, timeout o fallo del proveedor.
enum TriageSuggestionStatus {
  OK
  INVALID_OUTPUT
  TIMEOUT
  FAILED

  @@map("triage_suggestion_status")
  @@schema("asclepio")
}

/// Proveedor LLM que respondió (o el último intentado) en una solicitud de sugerencia.
enum LlmProvider {
  GROQ
  OPENROUTER

  @@map("llm_provider")
  @@schema("asclepio")
}

/// Sugerencia de triage: una fila por solicitud (D2 de F-04-api), solo inserciones (asclepio_app: SELECT e INSERT).
/// Dueño: ai. Es una propuesta, nunca una decisión: no modifica encounters (R23).
/// CHECK manuales (migración f04_triage_suggestions): coherencia de status con los niveles, rangos 1–5,
/// suggested_level <= llm_level (los guards solo suben la gravedad, R19), guard_applied y latency_ms >= 0.
model TriageSuggestion {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  encounterId    String                 @map("encounter_id") @db.Uuid
  requestedBy    String                 @map("requested_by") @db.Uuid
  /// Instantánea enviada al LLM (D7): sin nombre, documento, ids ni horas (RNF-04).
  inputSnapshot  Json                   @map("input_snapshot")
  status         TriageSuggestionStatus
  llmLevel       Int?                   @map("llm_level") @db.SmallInt
  suggestedLevel Int?                   @map("suggested_level") @db.SmallInt
  /// { summary, factors } (D9).
  explanation    Json?
  guardApplied   Boolean                @default(false) @map("guard_applied")
  guardReasons   Json                   @default("[]") @map("guard_reasons")
  provider       LlmProvider?
  model          String?
  promptVersion  String                 @map("prompt_version")
  /// Respuesta cruda del proveedor (texto: una salida inválida puede no ser JSON). Nunca se expone ni se registra.
  rawResponse    String?                @map("raw_response")
  tokensIn       Int?                   @map("tokens_in")
  tokensOut      Int?                   @map("tokens_out")
  latencyMs      Int                    @map("latency_ms")
  /// Una entrada por llamada a proveedor (D2): { provider, model, outcome, latencyMs, httpStatus }.
  attempts       Json
  /// Hora del servidor (Clock); sin default.
  createdAt      DateTime               @map("created_at") @db.Timestamptz(6)

  // Todas RESTRICT (las acciones referenciales se ejecutan como dueño y saltarían los grants append-only).
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encounter       Encounter        @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  requestedByUser User             @relation(fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decisions       TriageDecision[]

  @@unique([id, encounterId]) // F-05-api (D7): destino de la FK compuesta desde triage_decisions
  @@index([encounterId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("triage_suggestions")
  @@schema("asclepio")
}

// ---------------------------------------------------------------- F-05: decisión de triage

/// Acción de enfermería sobre el nivel de triage (F-05-api): validar o corregir la sugerencia vigente, o clasificar a mano.
enum TriageDecisionAction {
  VALIDATE
  CORRECT
  MANUAL

  @@map("triage_decision_action")
  @@schema("asclepio")
}

/// Decisión de triage: como mucho una por atención (PA-F05-1), solo inserciones (asclepio_app: SELECT e INSERT).
/// Dueño: triage. Es la única vía a TRIAGED (RNF-03, R11): se inserta en la misma transacción que fija final_level.
/// CHECK manuales (migración f05_triage_decisions): MANUAL ⇔ sin sugerencia, CORRECT ⇔ con motivo, motivo de 1 a 500
/// caracteres sin contar espacios extremos y nivel 1–5. FK compuesta (suggestion_id, encounter_id): la sugerencia es de la misma atención.
model TriageDecision {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  encounterId  String               @unique @map("encounter_id") @db.Uuid
  suggestionId String?              @map("suggestion_id") @db.Uuid
  action       TriageDecisionAction
  level        Int                  @db.SmallInt
  /// Motivo de corrección (PA-F05-2): solo en CORRECT. Nunca en eventos, auditoría ni logs (R21).
  reason       String?
  decidedBy    String               @map("decided_by") @db.Uuid
  /// Hora del servidor (Clock, R20); sin default.
  decidedAt    DateTime             @map("decided_at") @db.Timestamptz(6)

  // Todas RESTRICT (R19): las acciones referenciales se ejecutan como dueño y saltarían los grants append-only.
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encounter     Encounter         @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  // MATCH SIMPLE: no se comprueba mientras suggestion_id es NULL (MANUAL).
  suggestion    TriageSuggestion? @relation(fields: [suggestionId, encounterId], references: [id, encounterId], onDelete: Restrict, onUpdate: Restrict)
  decidedByUser User              @relation(fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("triage_decisions")
  @@schema("asclepio")
}
