{
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "rootDir": ".",
  "testRegex": ".int-spec.ts$",
  "setupFiles": ["<rootDir>/int/setup-env.ts"],
  "testTimeout": 60000
}
