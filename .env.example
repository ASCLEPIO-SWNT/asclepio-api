# Copia a .env y rellena. NUNCA subas .env.
NODE_ENV=development
PORT=3000

# Supabase (solo PostgreSQL). Rol de app: asclepio_app.
# Pooler en modo transacción (runtime):
DATABASE_URL="postgresql://asclepio_app.PROJECTREF:CHANGE_ME@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=asclepio"
# Conexión directa o de sesión (migraciones):
DIRECT_URL="postgresql://postgres.PROJECTREF:CHANGE_ME@aws-0-region.pooler.supabase.com:5432/postgres?schema=asclepio"

# Auth (F-01). JWT_SECRET: al menos 32 bytes o la API no arranca. Genera uno con: openssl rand -hex 32
JWT_SECRET=change-me-dev-only-at-least-32-bytes-long
# Consentimiento del paciente (Ley 1581): versión vigente y archivo con el texto (relativo a la raíz del repo).
PATIENT_CONSENT_VERSION=2026-10-v1
PATIENT_CONSENT_TEXT_PATH=docs/legal/consentimiento.md
# Límite de peticiones de los endpoints públicos (por IP y por endpoint).
THROTTLE_LIMIT=10
THROTTLE_TTL_MS=60000

# Pruebas de integración (npm run test:int): SOLO el PostgreSQL local de Docker (docker-compose.test.yml).
# Credenciales ficticias de desarrollo. El script aborta si estas URLs no apuntan a localhost/127.0.0.1.
TEST_DATABASE_URL="postgresql://asclepio_app:asclepio_app_local@localhost:54329/asclepio_test"
TEST_DIRECT_URL="postgresql://asclepio_test:asclepio_test_local@localhost:54329/asclepio_test"

# LLM (API compatible con OpenAI)
GROQ_API_KEY=gsk_example_not_real
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=sk-or-example-not-real
OPENROUTER_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=8000
LLM_TOTAL_BUDGET_MS=20000

# CORS (web local)
CORS_ORIGIN=http://localhost:5173
