              "schema": {
                "$ref": "#/components/schemas/StaffLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenDto"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones desde esta IP a este endpoint (application/problem+json).",
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta que termina la ventana del límite.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "default": {
            "description": "Error en application/problem+json (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/patient/login": {
      "post": {
        "operationId": "AuthController_loginPatient",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenDto"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones desde esta IP a este endpoint (application/problem+json).",
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta que termina la ventana del límite.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "default": {
            "description": "Error en application/problem+json (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/patient/accounts": {
      "post": {
        "operationId": "AuthController_createPatientAccount",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePatientAccountDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientAccountCreatedDto"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones desde esta IP a este endpoint (application/problem+json).",
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta que termina la ventana del límite.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "default": {
            "description": "Error en application/problem+json (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/StaffMeDto"
                    },
                    {
                      "$ref": "#/components/schemas/PatientMeDto"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "STAFF": "#/components/schemas/StaffMeDto",
                      "PATIENT": "#/components/schemas/PatientMeDto"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error en application/problem+json (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/consent": {
      "get": {
        "operationId": "ConsentController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentDto"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones desde esta IP a este endpoint (application/problem+json).",
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta que termina la ventana del límite.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "default": {
            "description": "Error en application/problem+json (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "public"
        ]
      }
    }
  },
  "info": {
    "title": "Asclepio API",
    "description": "Triage de urgencias asistido por IA. La IA propone, el profesional decide.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "time": {
            "type": "string",
            "description": "Hora del servidor (UTC, ISO-8601)",
            "example": "2026-10-26T19:42:00.000Z"
          }
        },
        "required": [
          "status",
          "time"
        ]
      },
      "PublicSiteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PublicTenantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicSiteDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "sites"
        ]
      },
      "StaffMeDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "STAFF"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "RECEPTION",
              "NURSE",
              "PHYSICIAN",
              "ADMIN"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "tenantId",
          "email",
          "fullName",
          "role"
        ]
      },
      "PatientMeDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "PATIENT"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id de la cuenta de paciente."
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "consentVersion": {
            "type": "string"
          },
          "identityVerified": {
            "type": "boolean",
            "description": "false hasta que recepción verifique la identidad (F-02)."
          }
        },
        "required": [
          "kind",
          "id",
          "tenantId",
          "patientId",
          "consentVersion",
          "identityVerified"
        ]
      },
      "StaffLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "enfermera@ips.example"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AccessTokenDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT HS256 de 8 h. No hay refresh token."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-26T23:00:00.000Z"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresAt"
        ]
      },
      "PatientLoginDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "documentType": {
            "type": "string",
            "enum": [
              "CC",
              "CE",
              "PA"
            ]
          },
          "documentNumber": {
            "type": "string",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "tenantId",
          "documentType",
          "documentNumber",
          "password"
        ]
      },
      "CreatePatientAccountDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "description": "IPS (de GET /public/tenants)."
          },
          "documentType": {
            "type": "string",
            "enum": [
              "CC",
              "CE",
              "PA"
            ]
          },
          "documentNumber": {
            "type": "string",
            "maxLength": 64
          },
          "fullName": {
            "type": "string",
            "maxLength": 200
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "example": "1990-05-17",
            "description": "Fecha civil YYYY-MM-DD; se exigen 18 años cumplidos en America/Bogota."
          },
          "sex": {
            "type": "string",
            "enum": [
              "M",
              "F",
              "X"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "format": "password"
          },
          "consentAccepted": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Debe ser true (Ley 1581). Si falta o es otro valor: 422."
          },
          "consentVersion": {
            "type": "object",
            "example": "2026-10-v1",
            "description": "Versión vigente de GET /public/consent. Si no coincide: 422."
          }
        },
        "required": [
          "tenantId",
          "documentType",
          "documentNumber",
          "fullName",
          "birthDate",
          "sex",
          "password",
          "consentAccepted",
          "consentVersion"
        ]
      },
      "PatientAccountCreatedDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id de la cuenta de paciente."
          },
          "patientId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "patientId"
        ]
      },
      "ConsentDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "2026-10-v1"
          },
          "text": {
            "type": "string",
            "description": "Texto del consentimiento (Markdown)."
          }
        },
        "required": [
          "version",
          "text"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Not Found"
          },
          "status": {
            "type": "number",
            "example": 404
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/encounters/123"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      }
    }
  }
}
